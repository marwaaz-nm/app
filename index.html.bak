function checkSurveyLrVisibility() {
    const ujeedo = document.getElementById('ref_ujeedo').value;
    const faahfaahin = document.getElementById('ref_faahfaahin').value.toLowerCase();
    const surveyLrContainer = document.getElementById('ref_survey_link').parentElement;

    // 1. Shuruudda Kirada (Rental Check)
    // Maadaama aynaan haysan badhan "Dhulka kirada", waxaan u qaadanaynaa inuu yahay TRUE 
    // haddii uusan ahayn "Cadeyn Heshiis Kiro".
    const rentalCondition = (ujeedo !== "Cadeyn Heshiis Kiro");

    // 2. Shuruudda Nooca (Type Check - IN & CONTAINS)
    const allowedUjeedo = ["Beec Dhul", "Sugitaan Milkiyad Dhul", "Sugitaan Dhaxalkoob", "Cadeyn Hibeyn/ Waqaf", "Codsi Sabarloog"];
    const keywords = ["dhul", "guri", "boos", "beer"];
    const hasKeyword = keywords.some(word => faahfaahin.includes(word));
    const typeCondition = allowedUjeedo.includes(ujeedo) || hasKeyword;

    // 3. Shuruudda Reebitaanka (Exclusion Check - NOT OR CONTAINS)
    const excludedWords = ["nootaay", "notary", "notaay", "duleed", "deegaan", "tuul"];
    const isExcluded = excludedWords.some(word => faahfaahin.includes(word));

    // ISKU DAR LOGIC-GA (AND Condition)
    if (rentalCondition && typeCondition && !isExcluded) {
        surveyLrContainer.style.display = "block";
        document.getElementById('ref_survey_link').setAttribute('required', 'true');
    } else {
        surveyLrContainer.style.display = "none";
        document.getElementById('ref_survey_link').removeAttribute('required');
        document.getElementById('ref_survey_link').value = ""; // Nadiifi haddii la qariyo
    }
}

// Ku xidh dhacdooyinka (Events) si uu u shaqeeyo marka qofka wax qorayo
document.getElementById('ref_ujeedo').addEventListener('change', checkSurveyLrVisibility);
document.getElementById('ref_faahfaahin').addEventListener('input', checkSurveyLrVisibility);

let allRefRecords = [];

// 1. Kala beddelka View-yada (Liiska iyo Foomka)
function showRefForm() {
    document.getElementById('refListArea').style.display = 'none';
    document.getElementById('refFormArea').style.display = 'block';
    setupRefForm(); // Taariikhda maanta
    populateSurveyDropdown(); // Buuxi dropdown-ka Survey Lr
    checkSurveyLrVisibility(); // Hubi inuu muuqanayo Survey Lr
}

function hideRefForm() {
    document.getElementById('refListArea').style.display = 'block';
    document.getElementById('refFormArea').style.display = 'none';
}

// 2. AppSheet Logic: Goormuu muuqanayaa Survey Lr?
function checkSurveyLrVisibility() {
    const ujeedo = document.getElementById('ref_ujeedo').value;
    const faahfaahin = document.getElementById('ref_faahfaahin').value.toLowerCase();
    const wrapper = document.getElementById('surveyLrWrapper');
    const select = document.getElementById('ref_survey_link');

    // Logic-ga aad bixisay:
    const rentalCondition = (ujeedo !== "Cadeyn Heshiis Kiro");
    
    const allowedUjeedo = ["Beec Dhul", "Sugitaan Milkiyad Dhul", "Sugitaan Dhaxalkoob", "Cadeyn Hibeyn/ Waqaf", "Codsi Sabarloog"];
    const keywords = ["dhul", "guri", "boos", "beer"];
    const hasKeyword = keywords.some(word => faahfaahin.includes(word));
    const typeCondition = allowedUjeedo.includes(ujeedo) || hasKeyword;

    const excludedWords = ["nootaay", "notary", "notaay", "duleed", "deegaan", "tuul"];
    const isExcluded = excludedWords.some(word => faahfaahin.includes(word));

    if (rentalCondition && typeCondition && !isExcluded) {
        wrapper.style.display = "block";
        select.setAttribute('required', 'true');
    } else {
        wrapper.style.display = "none";
        select.removeAttribute('required');
        select.value = "";
    }
}

// 3. Load & Render References
async function loadReferences() {
    const tbody = document.getElementById('refTableBody');
    
    // 1. Hubi haddii xog hore ay jirto si aan mar kale loo soo dejin
    if (allRefRecords && allRefRecords.length > 0) {
        renderRefData(allRefRecords);
        return;
    }

    try {
        // MUHIIM: Waxaan ku darnay ?action=getReferences URL-ka
        const res = await fetch(SCRIPT_URL + "?action=getReferences");
        allRefRecords = await res.json();
        
        if (allRefRecords.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="text-center p-4">Ma jirto xog Reference ah oo la helay.</td></tr>';
        } else {
            renderRefData(allRefRecords);
        }
    } catch (e) {
        console.error("Error:", e);
        tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger p-4">Cillad ayaa dhacday xilliga soo dejinta xogta.</td></tr>';
    }
}

function renderRefData(data) {
    const tbody = document.getElementById('refTableBody');
    const isMobile = window.innerWidth < 768;
    const refListArea = document.getElementById('refListArea');

    // Helper function to clean technical dates (e.g., 2026-03-21T13:58:00.000Z)
    const formatDateMobile = (dateStr) => {
        if (!dateStr || dateStr === 'N/A') return '';
        try {
            // Split by 'T' and take the date and first 5 chars of time
            const parts = dateStr.split('T');
            return parts[0] + ' ' + parts[1].substring(0, 5);
        } catch (e) {
            return dateStr;
        }
    };

    if (isMobile) {
        const cardsHtml = `<div class="mobile-cards-container">
            ${data.map(r => {
                const status = r['Status'] || 'In Progress';
                let badgeClass = status === 'Completed' ? 'bg-primary' : (status === 'Picked Up' ? 'bg-success' : 'bg-warning');
                
                return `
                <div class="survey-card" onclick='showRefDetails(${JSON.stringify(r)})'>
                    <div class="card-info">
                        <div class="d-flex justify-content-between">
                            <span class="fw-bold text-primary">${r['Sumad (Ref)']}</span>
                            <span class="badge ${badgeClass} rounded-pill" style="font-size:10px">${status}</span>
                        </div>
                        <div class="card-name mt-1">${r['Ujeedo']}</div>
                        <div class="card-date small text-muted">
                            <i class="bi bi-calendar3 me-1"></i> ${formatDateMobile(r['Taariikhda Dukumiintiga'])}
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </div>`;
            }).join('')}
        </div>`;
        
        // 1. Hide the desktop table wrapper on mobile
        const tableContainer = refListArea.querySelector('.table-responsive');
        if (tableContainer) tableContainer.style.display = 'none';
        
        // 2. Populate the mobile card container
        let mobileContainer = document.getElementById('refMobileCards');
        if (!mobileContainer) {
            mobileContainer = document.createElement('div');
            mobileContainer.id = 'refMobileCards';
            refListArea.appendChild(mobileContainer);
        }
        mobileContainer.innerHTML = cardsHtml;

    } else {
        // Desktop View: Ensure table is visible and cards are hidden
        const tableContainer = refListArea.querySelector('.table-responsive');
        if (tableContainer) tableContainer.style.display = 'block';
        
        const mobileContainer = document.getElementById('refMobileCards');
        if (mobileContainer) mobileContainer.innerHTML = '';

        tbody.innerHTML = data.map(r => {
            const status = r['Status'] || 'In Progress';
            let badgeClass = status === 'Completed' ? 'bg-primary' : (status === 'Picked Up' ? 'bg-success' : 'bg-warning');
            return `
                <tr onclick='showRefDetails(${JSON.stringify(r)})' style="cursor: pointer;">
                    <td class="fw-bold text-primary">${r['Sumad (Ref)']}</td>
                    <td><small>${r['Survey Lr'] || 'N/A'}</small></td>
                    <td><span class="badge bg-light text-dark border">${r['Ujeedo']}</span></td>
                    <td><span class="badge ${badgeClass} shadow-sm px-3 rounded-pill" style="font-size: 10px;">${status}</span></td>
                    <td class="text-center"><button class="btn btn-sm btn-outline-info rounded-pill px-3 shadow-none">View</button></td>
                </tr>`;
        }).join('');
    }
}
function showRefDetails(record) {
    const rawDate = record['Taariikhda Dukumiintiga'] || '-';
    const cleanDate = rawDate.replace('T', ' ').split('.')[0];

    // Update Text Content
    document.getElementById('v_ref_sumad_badge').innerText = record['Sumad (Ref)'] || '-';
    document.getElementById('v_ref_date').innerText = cleanDate;
    document.getElementById('v_ref_ujeedo').innerText = record['Ujeedo'] || '-';
    document.getElementById('v_ref_faahfaahin').innerText = record['Faahfaahin'] || 'No additional notes provided.';
    
    // Toggle Survey Link Section
    const surveyLr = record['Survey Lr'];
    const section = document.getElementById('v_ref_survey_section');
    if (surveyLr && surveyLr !== "N/A" && surveyLr !== "") {
        section.style.setProperty('display', 'block', 'important');
        document.getElementById('v_ref_survey_lr').innerText = surveyLr;
    } else {
        section.style.setProperty('display', 'none', 'important');
    }

    // Set initial active step based on record status
    const status = record['Status'] || 'In Progress';
    updateStatusUI_VisualOnly(status); // Helper to just set colors without triggering alert/DB

    const myModal = new bootstrap.Modal(document.getElementById('refDetailsModal'));
    myModal.show();
}

// Function to update UI visuals and call the database
async function updateStatusUI(status) {
    // 1. Trigger the actual DB update
    await updateRefStatus(status);

    // 2. Update UI Visuals
    const statusMap = { 'In Progress': 'bg-warning text-dark', 'Completed': 'bg-primary text-white', 'Picked Up': 'bg-success text-white' };
    
    // Update top badge
    const badge = document.getElementById('current_status_badge');
    badge.innerText = status;
    badge.className = `badge rounded-pill small px-3 ${statusMap[status]}`;

    // Update steps
    document.querySelectorAll('.step-item').forEach(item => item.classList.remove('active'));
    const safeId = status.replace(/\s+/g, '_');
    document.getElementById(`step_${safeId}`).classList.add('active');
}

function updateStatusUI_VisualOnly(status) {
    const statusMap = { 'In Progress': 'bg-warning text-dark', 'Completed': 'bg-primary text-white', 'Picked Up': 'bg-success text-white' };
    const badge = document.getElementById('current_status_badge');
    if(badge) {
        badge.innerText = status;
        badge.className = `badge rounded-pill small px-3 ${statusMap[status] || 'bg-secondary'}`;
    }
    
    document.querySelectorAll('.step-item').forEach(item => item.classList.remove('active'));
    const safeId = (status || 'In Progress').replace(/\s+/g, '_');
    const target = document.getElementById(`step_${safeId}`);
    if(target) target.classList.add('active');
}

// 2. Soo saar liiska References si lacag looga qabto
async function loadReceiptRefs() {
    const tbody = document.getElementById('receiptRefTableBody');
    // Muuji loading-ka labada dhinacba
    tbody.innerHTML = '<tr><td colspan="4" class="text-center p-4"><span class="spinner-border spinner-border-sm"></span> Cusboonaysiinaya xogta dakhliga...</td></tr>';
    
    try {
        // 1. Mar quda wada wac dhammaan xogta (Parallel Fetching)
        const [resRef, resRec, resExp] = await Promise.all([
            fetch(SCRIPT_URL + "?action=getReferences"),
            fetch(SCRIPT_URL + "?action=getReceipts"),
            fetch(SCRIPT_URL + "?action=getExpenses") // Hubi in Apps Script uu leeyahay action-kan
        ]);

        allRefRecords = await resRef.json();
        const allReceipts = await resRec.json();
        const allExpenses = await resExp.json();
        renderExpensesTable(allExpenses);

        // 2. DASHBOARD CALCULATIONS
        // Xisaabi Wadarta Dakhliga (Paid Only)
        const totalRevenue = allReceipts
            .filter(r => r && r['Status'] === 'Paid')
            .reduce((sum, r) => sum + parseFloat(r['Amount'] || 0), 0);

        // Xisaabi Wadarta Kharashka
        const totalExpAmount = allExpenses
            .reduce((sum, e) => sum + parseFloat(e['Amount'] || 0), 0);

        // Cusboonaysii Dashboard-ka (HTML IDs waa inay jiraan)
        document.getElementById('total_revenue').innerText = '$' + totalRevenue.toLocaleString(undefined, {minimumFractionDigits: 2});
        document.getElementById('total_expenses').innerText = '$' + totalExpAmount.toLocaleString(undefined, {minimumFractionDigits: 2});

        // 3. RENDER PAYMENTS TABLE
        const paidRefs = allReceipts
            .filter(r => r && r['Sumad (Ref)'] && r['Status'] === 'Paid') 
            .map(r => r['Sumad (Ref)'].toString().trim().toLowerCase());

        const validRefs = allRefRecords.filter(r => r && r['Sumad (Ref)']);

        if (validRefs.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center p-4">Ma jiraan wax tixraac (References) ah.</td></tr>';
        } else {
            tbody.innerHTML = validRefs.map(r => {
                const currentRefRaw = r['Sumad (Ref)'].toString().trim();
                const isPaid = paidRefs.includes(currentRefRaw.toLowerCase());

                return `
                    <tr>
                        <td class="fw-bold text-primary ps-4">${currentRefRaw}</td>
                        <td>${r['Ujeedo'] || 'N/A'}</td>
                        <td><small class="text-muted">${r['Taariikhda Dukumiintiga'] || '-'}</small></td>
                        <td class="text-center">
                            ${isPaid ? 
                                `<span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i> Paid
                                 </span>` : 
                                `<button class="btn btn-success btn-sm px-4 rounded-pill shadow-sm" 
                                         onclick="openPayModal('${currentRefRaw}', '${r['Ujeedo']}')">
                                    <i class="bi bi-currency-dollar"></i> Pay
                                 </button>`
                            }
                        </td>
                    </tr>`;
            }).join('');
        }

        // 4. RENDER EXPENSES TABLE (Haddii aad leedahay meel loogu talagalay)
        if (typeof renderExpensesTable === "function") {
            renderExpensesTable(allExpenses);
        }

    } catch (e) {
        console.error("Finance Loading Error:", e);
        tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger p-4">Cillad dhinaca xogta maaliyadda ah.</td></tr>';
    }
}

// 3. Fur Modal-ka oo buuxi xogta qaar
function openPayModal(ref, ujeedo, receiptInfo = null) {
    document.getElementById('rec_ref').value = ref;
    document.getElementById('rec_details').value = ujeedo;
    document.getElementById('rec_date').value = new Date().toISOString().split('T')[0];
    
    const statusSelect = document.getElementById('rec_status');
    const recNoInput = document.getElementById('rec_no');

    // Function yar oo dhalisa Receipt No haddii ay muhiim tahay
    const updateReceiptNo = () => {
        if (statusSelect.value === "Paid") {
            recNoInput.value = "REC-" + Math.floor(1000 + Math.random() * 9000);
        } else {
            recNoInput.value = "N/A"; // Ama bannaanteeda uga tag
        }
    };

    // Marka hore deji status-ka
    statusSelect.value = receiptInfo ? "Paid" : "Paid"; 
    updateReceiptNo();

    // Haddii qofku modal-ka dhexdiisa ka beddelo Status-ka (Paid -> Credit)
    statusSelect.onchange = updateReceiptNo;

    const amountInput = document.getElementById('rec_amount');
    amountInput.value = receiptInfo ? receiptInfo['Amount'] : "";

    new bootstrap.Modal(document.getElementById('payModal')).show();
}

// 4. Keydi Resiidhka
document.getElementById('receiptForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    const originalText = btn.innerHTML;
    
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Keydinaya...';

    const payload = {
        type: "receipt",
        rec_no: document.getElementById('rec_no').value,
        ref: document.getElementById('rec_ref').value,
        details: document.getElementById('rec_details').value,
        date: document.getElementById('rec_date').value,
        amount: document.getElementById('rec_amount').value,
        status: document.getElementById('rec_status').value,
        mode: document.getElementById('rec_mode').value
    };

    try {
        const res = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        
        const result = await res.json();
        
        if (result.result === "success") {
            // 1. Qari Modal-ka
            const payModal = bootstrap.Modal.getInstance(document.getElementById('payModal'));
            if (payModal) payModal.hide();

            // 2. Nadiifi foomka
            document.getElementById('receiptForm').reset();
            
            alert("Resiidhka si guul leh ayaa loo keydiyey!");

            // 3. MUHIIM: Dib u rari dhamaan xogta system-ka (Pre-loading function-kaaga)
            // Kani wuxuu xaqiijinayaa in allReceipts ay cusboonaysiistaan
            if (typeof loadAllSystemData === "function") {
                await loadAllSystemData(); 
            } else {
                await loadReceiptRefs(); 
            }
        } else {
            alert("Cillad: " + result.message);
        }
    } catch (err) {
        console.error("Save Error:", err);
        alert("Ma suuragalin in xogta la keydiyo.");
    } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
    }
});



let currentUser = null;

// 1. Run this when the page loads
document.addEventListener("DOMContentLoaded", () => {
    const savedUser = localStorage.getItem("geo_user");
    const savedPass = localStorage.getItem("geo_pass");
    const fab = document.getElementById('smartFab');
    if (document.getElementById('loginOverlay').style.display !== 'none') {
        if (fab) fab.style.display = 'none';
    }

    if (savedUser && savedPass) {
        document.getElementById("loginUser").value = savedUser;
        document.getElementById("loginPass").value = savedPass;
        document.getElementById("rememberMe").checked = true;
    }
});

// 2. Update your existing Login Form Listener
document.getElementById('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const user = document.getElementById('loginUser').value;
    const pass = document.getElementById('loginPass').value;
    const remember = document.getElementById('rememberMe').checked;

    const btn = document.getElementById('loginBtn');
    btn.disabled = true;
    btn.innerText = "Xaqiijinaya...";

    // Handle Remember Me logic
    if (remember) {
        localStorage.setItem("geo_user", user);
        localStorage.setItem("geo_pass", pass);
    } else {
        localStorage.removeItem("geo_user");
        localStorage.removeItem("geo_pass");
    }

    const payload = { type: "login", username: user, password: pass };

    try {
        const res = await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) });
        const result = await res.json();

        if (result.status === "success") {
            currentUser = result;
            document.getElementById('loginOverlay').style.display = 'none';
            document.getElementById('display_fullname').innerText = result.name || result.username;
            document.getElementById('display_role').innerText = result.role;
            manageTabAccess(result.role);
            loadAllSystemData();
            const fab = document.getElementById('smartFab');
             if (fab) fab.style.display = 'flex'; // Show FAB after login
        } else {
            alert("Username ama Password waa khalad!");
        }
    } catch (err) {
        alert("Cillad ayaa dhacday xilliga login-ka!");
    } finally {
        btn.disabled = false;
        btn.innerHTML = 'SIGN IN <i class="bi bi-arrow-right-short ms-1"></i>';
    }
});

// 2. TABS ACCESS CONTROL
function manageTabAccess(role) {
    const userTab = document.getElementById('userTabBtn');
    if (userTab) {
        if (role === "Admin") {
            userTab.style.setProperty('display', 'block', 'important');
        } else {
            userTab.style.setProperty('display', 'none', 'important');
        }
    }
}

/**
 * Function-ka sawiraya (Render) xogta isticmaalayaasha ee miiska.
 * Kani wuxuu xallinayaa "renderUserData is not defined".
 */
function renderUserData(users) {
    const tbody = document.getElementById('userTableBody');
    const userView = document.getElementById('user-management');
    const isMobile = window.innerWidth < 768;

    if (!userView) return;
    const validUsers = users.filter(u => u && u.Username);

    if (isMobile) {
        let mobileUserContainer = document.getElementById('mobileUserCards');
        if (!mobileUserContainer) {
            mobileUserContainer = document.createElement('div');
            mobileUserContainer.id = 'mobileUserCards';
            mobileUserContainer.className = 'mobile-cards-container';
            userView.querySelector('.p-2').appendChild(mobileUserContainer);
        }

        mobileUserContainer.innerHTML = validUsers.length === 0
            ? '<div class="text-center p-4">No users found.</div>'
            : validUsers.map(u => `
                <div class="survey-card">
                    <div class="user-avatar me-3"><i class="bi bi-person-circle h3 text-primary mb-0"></i></div>
                    <div class="card-info">
                        <div class="fw-bold">${u['Full Name'] || u.fullname || u.Username}</div>
                        <div class="small text-muted">@${u.Username}</div>
                        <span class="badge ${u.Role === 'Admin' ? 'bg-danger' : 'bg-info'} mt-1">${u.Role}</span>
                    </div>
                    <button class="btn text-danger ms-auto" onclick="deleteUser('${u.Username}')" 
                        ${u.Username.toLowerCase() === 'admin' ? 'disabled' : ''}>
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `).join('');
    } else if (tbody) {
        tbody.innerHTML = validUsers.map(u => `
            <tr>
                <td class="fw-bold text-dark">${u.Username}</td>
                <td>${u['Full Name'] || u.fullname || '-'}</td>
                <td><span class="badge ${u.Role === 'Admin' ? 'bg-danger' : 'bg-info'} px-3 rounded-pill">${u.Role}</span></td>
                <td class="text-center">
                    <button class="btn btn-sm text-danger" onclick="deleteUser('${u.Username}')" 
                        ${u.Username.toLowerCase() === 'admin' ? 'disabled' : ''}>
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `).join('');
    }
}

/**
 * Cusboonaysii loadUsers() si uu u isticmaalo renderUserData
 */
async function loadUsers() {
    const tbody = document.getElementById('userTableBody');
    if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="text-center p-4">Loading users...</td></tr>';
    
    try {
        const res = await fetch(SCRIPT_URL + "?action=getUsers");
        const users = await res.json();
        
        // Hadda waxaan u yeeraynaa function-ka render-ka
        renderUserData(users);
        
    } catch (e) {
        if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="text-center text-danger">Error loading users.</td></tr>';
    }
}

document.getElementById('addUserForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Kaydinaya...';

    const payload = {
        type: "addUser",
        username: document.getElementById('new_username').value,
        password: document.getElementById('new_password').value,
        role: document.getElementById('new_role').value,
        fullname: document.getElementById('new_fullname').value
    };

    try {
        const res = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: { 'Content-Type': 'text/plain;charset=utf-8' }
        });
        const result = await res.json();
        
        if (result.result === "success") {
            alert("User-ka si guul leh ayaa loo daray!");
            const modal = bootstrap.Modal.getInstance(document.getElementById('addUserModal'));
            modal.hide();
            document.getElementById('addUserForm').reset();
            loadUsers();
        } else {
            alert("Cillad: " + result.message);
        }
    } catch (err) {
        alert("Cillad ayaa dhacday xilliga kaydinta.");
    } finally {
        btn.disabled = false;
        btn.innerText = "Save User";
    }
});

// 4. DELETE USER
async function deleteUser(username) {
    if (username === 'admin') return;
    if (!confirm("Ma hubaal ayaad tahay inaad tirtirto " + username + "?")) return;
    
    const payload = { type: "deleteUser", username: username };
    try {
        await fetch(SCRIPT_URL, { method: 'POST', body: JSON.stringify(payload) });
        loadUsers();
    } catch (err) {
        alert("Ma suuragalin in user-ka la tirtiro.");
    }
}

// 5. LOGOUT
function logout() {
    currentUser = null;
    location.reload(); 
}

// Function-ka hal mar wada raraya dhammaan xogta
async function loadAllSystemData() {
    console.log("System Loading: Keenista dhamaan xogta...");
    
    try {
        // 1. Mar quda wada wac dhammaan 6-ta xogood (Parallel Fetching)
        // Waxaan ku darnay 'getTransfers'
        const [resRecords, resRefs, resReceipts, resUsers, resExpenses, resTransfers] = await Promise.all([
            fetch(SCRIPT_URL),                                  // SurveyData
            fetch(SCRIPT_URL + "?action=getReferences"),        // References
            fetch(SCRIPT_URL + "?action=getReceipts"),          // Receipts
            fetch(SCRIPT_URL + "?action=getUsers"),             // Users
            fetch(SCRIPT_URL + "?action=getExpenses"),          // Office Expenses
            fetch(SCRIPT_URL + "?action=getTransfers")          // CUSUB: Wareejin Dhul
        ]);

        // 2. Bedel xogta una rogo JSON
        allRecords = await resRecords.json();
        allRefRecords = await resRefs.json();
        const allReceipts = await resReceipts.json();
        const allUsers = await resUsers.json();
        const allExpenses = await resExpenses.json();
        allTransferRecords = await resTransfers.json(); // CUSUB: Keydi xogta wareejinta

        // --- MUHIIM: Draw polygons on the Map Explorer once records are ready ---
        if (allRecords && allRecords.length > 0) {
            displayAllPolygons();
        }

        // 3. DASHBOARD CALCULATIONS
        // A. Dakhliga Guud (Receipts)
        const totalRevenue = allReceipts
            .filter(r => r && (r.Status === 'Paid' || r['Status'] === 'Paid'))
            .reduce((sum, r) => sum + parseFloat(r.Amount || r['Amount'] || 0), 0);

        // B. Kharashka Guud (Expenses)
        const totalExpAmount = allExpenses
            .reduce((sum, e) => sum + parseFloat(e.Total || e['Total'] || 0), 0);
            
        // C. (IKHTIYAARI) Dakhliga Iibka Dhulka - Haddii aad rabto inaad dashboardka ku darto
        const totalTransferSales = allTransferRecords
            .reduce((sum, t) => sum + parseFloat(t.Lacagta || t['Lacagta'] || 0), 0);

        // Ku muuji Dashboard-ka dushiisa (Hubi in HTML IDs ay jiraan)
        if(document.getElementById('total_revenue')) {
            document.getElementById('total_revenue').innerText = '$' + totalRevenue.toLocaleString(undefined, {minimumFractionDigits: 2});
        }
        if(document.getElementById('total_expenses')) {
            document.getElementById('total_expenses').innerText = '$' + totalExpAmount.toLocaleString(undefined, {minimumFractionDigits: 2});
        }
        // Haddii aad leedahay meel loogu talagalay dakhliga iibka:
        if(document.getElementById('total_transfer_sales')) {
            document.getElementById('total_transfer_sales').innerText = '$' + totalTransferSales.toLocaleString(undefined, {minimumFractionDigits: 2});
        }

        // 4. Buuxi Tables-ka background-ka (Rendering)
        applyFilters();                                 // 1. Records Table
        renderRefData(allRefRecords);                   // 2. References Table
        renderReceiptTable(allRefRecords, allReceipts); // 3. Receipts Table
        renderExpensesTable(allExpenses);               // 4. Expenses Table
        renderTransferTable(allTransferRecords);        // 5. CUSUB: Wareejinta Table

        // 5. Buuxi Users Table (Kaliya haddii uu Admin yahay)
        if (currentUser && currentUser.role === "Admin") {
            renderUserData(allUsers);
        }

        console.log("System Ready: Dhamaan xogta (oo ay ku jirto Wareejinta) waa la soo dejiyey.");
    } catch (error) {
        console.error("Cillad xilliga pre-loading-ka:", error);
    }
}

/**
 * CUSUB: Function-ka render-gareynaya shaxda Wareejinta
 */
function renderTransferTable(transfers) {
    const tbody = document.getElementById('transferTableBody');
    if (!tbody) return;

    if (transfers.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" class="text-center p-4">Ma jirto xog wareejin ah.</td></tr>';
        return;
    }

    tbody.innerHTML = transfers.map(t => `
        <tr>
            <td>${t['S/N'] || t.sn}</td>
            <td class="fw-bold">${t['Iibiyaha/Iibisada'] || t.iibiyaha}</td>
            <td class="fw-bold text-primary">${t['Iibsadaha/Iibsatada'] || t.iibsadaha}</td>
            <td><span class="badge bg-light text-dark border">${t['Survey lr ka'] || t.survey_lr}</span></td>
            <td class="fw-bold text-success">$${parseFloat(t.Lacagta || 0).toLocaleString()}</td>
            <td><small>${t.Taarikhda || t.taariikh}</small></td>
        </tr>
    `).join('');
}

// Helper function si Receipts loo render-gareeyo
function renderReceiptTable(refs, receipts) {
    const tbody = document.getElementById('receiptRefTableBody');
    const isMobile = window.innerWidth < 768;
    if (!tbody) return;

    const htmlContent = refs.filter(r => r && r['Sumad (Ref)']).map(r => {
        const refRaw = r['Sumad (Ref)'].toString().trim();
        const receiptInfo = receipts.find(rec => rec['Sumad (Ref)'].toString().trim().toLowerCase() === refRaw.toLowerCase());
        const isFullyPaid = receiptInfo && receiptInfo['Status'] === 'Paid';

        if (isMobile) {
            return `
            <div class="survey-card" ${receiptInfo ? `onclick='showReceiptDetails(${JSON.stringify(receiptInfo)})'` : ''}>
                <div class="card-info">
                    <div class="fw-bold text-primary">${refRaw}</div>
                    <div class="card-name small">${r['Ujeedo'] || 'N/A'}</div>
                    <div class="mt-2">
                        ${isFullyPaid ? 
                            `<span class="badge bg-success-subtle text-success border border-success w-100 py-2">Paid</span>` : 
                            `<button class="btn btn-success btn-sm w-100 rounded-pill" onclick='event.stopPropagation(); openPayModal("${refRaw}", "${r['Ujeedo']}", ${receiptInfo ? JSON.stringify(receiptInfo) : 'null'})'>Pay Now</button>`
                        }
                    </div>
                </div>
            </div>`;
        } else {
            return `
            <tr ${receiptInfo ? `onclick='showReceiptDetails(${JSON.stringify(receiptInfo)})'` : ''} style="cursor: pointer;">
                <td class="fw-bold text-primary">${refRaw}</td>
                <td>${r['Ujeedo'] || 'N/A'}</td>
                <td><small>${r['Taariikhda Dukumiintiga'] || '-'}</small></td>
                <td class="text-center">
                    ${isFullyPaid ? `<span class="badge bg-success-subtle text-success border border-success px-3 py-2 rounded-pill">Paid</span>` : 
                    `<button class="btn btn-success btn-sm px-4 rounded-pill" onclick='event.stopPropagation(); openPayModal("${refRaw}", "${r['Ujeedo']}", ${receiptInfo ? JSON.stringify(receiptInfo) : 'null'})'>Pay</button>`}
                </td>
            </tr>`;
        }
    }).join('');

    if (isMobile) {
        tbody.closest('.table-responsive').style.display = 'none';
        let mobileFinance = document.getElementById('mobileFinanceCards');
        if (!mobileFinance) {
            mobileFinance = document.createElement('div');
            mobileFinance.id = 'mobileFinanceCards';
            mobileFinance.className = 'mobile-cards-container';
            tbody.closest('.tab-pane').appendChild(mobileFinance);
        }
        mobileFinance.innerHTML = htmlContent;
    } else {
        tbody.innerHTML = htmlContent;
    }
}

function showReceiptDetails(receipt) {
    document.getElementById('v_rec_no').innerText = receipt['Receipt No'] || 'N/A';
    document.getElementById('v_rec_ref').innerText = receipt['Sumad (Ref)'] || '-';
    document.getElementById('v_rec_amount').innerText = '$' + (receipt['Amount'] || '0.00');
    document.getElementById('v_rec_mode').innerText = receipt['Mode'] || 'Cash';
    document.getElementById('v_rec_details').innerText = receipt['Faahfaahin'] || '-';
    document.getElementById('v_rec_date').innerText = receipt['Date'] || receipt['System Date'] || '-';
    
    // Bedel qoraalka status-ka
    const statusText = document.getElementById('v_rec_status_text');
    statusText.innerText = receipt['Status'] === 'Paid' ? 'Lacag Bixin Dhameystiran' : 'Xogta deynta (Credit)';
    statusText.className = receipt['Status'] === 'Paid' ? 'text-success small mb-0' : 'text-danger small mb-0';

    const myModal = new bootstrap.Modal(document.getElementById('receiptDetailsModal'));
    myModal.show();
}

async function downloadSurveyPDF() {
    // 1. Dooro qaybta Modal-ka ee la daabacayo
    const element = document.querySelector("#detailsModal .modal-content");
    const magaca = document.getElementById('view_magaca').innerText;
    const sn = document.getElementById('view_sn').innerText;

    // 2. Options-ka PDF-ka
    const options = {
        margin:       [10, 10, 10, 10],
        filename:     `Survey_Report_${sn}_${magaca.replace(/\s+/g, '_')}.pdf`,
        image:        { type: 'jpeg', quality: 0.98 },
        html2canvas:  { 
            scale: 2, 
            useCORS: true, // Muhiim u ah sawirada maabka
            logging: false,
            letterRendering: true
        },
        jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    // 3. Muuji Loading state
    const btn = document.querySelector('button[onclick="downloadSurveyPDF()"]');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Diyaarinta...';

    // 4. Qari badhamada inta la qaadayo snapshot-ka
    btn.style.visibility = 'hidden';
    document.querySelector("#detailsModal .btn-close").style.visibility = 'hidden';

    try {
        await html2pdf().set(options).from(element).save();
    } catch (error) {
        console.error("PDF Error:", error);
        alert("Ma suuragalin in PDF-ka la soo dejiyo.");
    } finally {
        // Dib u soo celi badhamada
        btn.disabled = false;
        btn.innerHTML = originalText;
        btn.style.visibility = 'visible';
        document.querySelector("#detailsModal .btn-close").style.visibility = 'visible';
    }
}

async function generateProfessionalPDF() {
    const element = document.querySelector("#detailsModal .modal-content");
    const magaca = document.getElementById('view_magaca').innerText;
    const sn = document.getElementById('view_sn').innerText;

    // Options-ka PDF-ka
    const options = {
        margin: [10, 10, 10, 10],
        filename: `Official_Survey_Report_${sn}.pdf`,
        image: { type: 'jpeg', quality: 1.0 },
        html2canvas: { scale: 3, useCORS: true, letterRendering: true },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
    };

    // 1. Samee Header rasmi ah oo ku meel gaar ah (Hidden Template)
    const headerHTML = `
        <div style="text-align: center; border-bottom: 2px solid #000; padding-bottom: 10px; margin-bottom: 20px;">
            <h2 style="margin: 0; color: #0d6efd;">GEOSURVEY PROFESSIONAL SYSTEM</h2>
            <h4 style="margin: 5px 0;">WARBIXINTA SAHANKA IYO QIIMEYNTA DHULKA</h4>
            <p style="margin: 0; font-size: 12px; color: #666;">Taariikhda: ${new Date().toLocaleDateString()}</p>
        </div>
    `;

    // 2. Samee Footer-ka Saxiixa
    const footerHTML = `
        <div style="margin-top: 40px; display: flex; justify-content: space-between; padding: 0 40px;">
            <div style="text-align: center;">
                <p style="border-top: 1px solid #000; padding-top: 5px; width: 150px;">Saxiixa Milkiilaha</p>
            </div>
            <div style="text-align: center;">
                <p style="border-top: 1px solid #000; padding-top: 5px; width: 150px;">Saxiixa Injineerka</p>
            </div>
        </div>
        <div style="text-align: center; margin-top: 30px;">
            <p style="font-size: 10px; color: #999;">Dukumiintigan waa mid elektaroonig ah oo ka soo baxay GeoSurvey System.</p>
        </div>
    `;

    // Diyaarinta Loading
    const btn = document.querySelector('button[onclick="generateProfessionalPDF()"]');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Diyaarinta...';

    // Qari badhamada nidaamka si aysan PDF-ka ugu soo bixin
    const buttonsToHide = document.querySelectorAll("#detailsModal .btn-close, #detailsModal button");
    buttonsToHide.forEach(b => b.style.opacity = '0');

    try {
        // Waxaan ku dhex dareynaa Header-ka iyo Footer-ka Modal-ka dhexdiisa si kumeel gaar ah
        const modalBody = document.querySelector("#detailsModal .modal-content");
        modalBody.insertAdjacentHTML('afterbegin', headerHTML);
        modalBody.insertAdjacentHTML('beforeend', footerHTML);

        await html2pdf().set(options).from(element).save();

        // Ka saar Header-ka iyo Footer-ka kumeel gaarka ahaa
        modalBody.querySelector('div').remove(); // Kii u horreeyey (Header)
        modalBody.lastElementChild.remove();     // Kii dambeeyey (Footer)
        
    } catch (error) {
        console.error("PDF Error:", error);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-printer-fill me-1"></i> PRINT REPORT (PDF)';
        buttonsToHide.forEach(b => b.style.opacity = '1');
    }
}

async function updateRefStatus(newStatus) {
    // Change 'v_ref_sumad' to 'v_ref_sumad_badge'
    const refId = document.getElementById('v_ref_sumad_badge').innerText; 
    
    if (!refId || refId === '-') return;

    if (!confirm(`Ma rabtaa inaad u beddesho: ${newStatus}?`)) return;

    try {
        const payload = {
            type: "updateRefStatus",
            sumad: refId,
            status: newStatus
        };

        const res = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload)
        });

        const result = await res.json();
        if (result.result === "success") {
            alert("Heerka shaqada waa la cusboonaysiiyey!");
            bootstrap.Modal.getInstance(document.getElementById('refDetailsModal')).hide();
            
            // Refresh data
            allRefRecords = []; 
            loadReferences(); 
        }
    } catch (e) {
        console.error(e);
        alert("Cillad ayaa dhacday xilliga beddelka status-ka.");
    }
}

// 1. Fur Modal-ka oo deji taariikhda maanta
function showExpenseModal() {
    document.getElementById('expenseForm').reset();
    document.getElementById('exp_date').value = new Date().toISOString().split('T')[0];
    document.getElementById('exp_total').value = "0.00";
    new bootstrap.Modal(document.getElementById('expenseModal')).show();
}

// 2. Xisaabi Total-ka si otomaatik ah
function calculateExpTotal() {
    const qty = parseFloat(document.getElementById('exp_qty').value) || 0;
    const amount = parseFloat(document.getElementById('exp_amount').value) || 0;
    const total = qty * amount;
    document.getElementById('exp_total').value = total.toFixed(2);
}

// 3. Save Expense to Database
document.getElementById('expenseForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type="submit"]');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Saving...';

    const payload = {
        type: "expense",
        description: document.getElementById('exp_desc').value,
        date: document.getElementById('exp_date').value,
        qty: document.getElementById('exp_qty').value,
        amount: document.getElementById('exp_amount').value,
        total: document.getElementById('exp_total').value,
        created_by: currentUser ? currentUser.name : "Unknown User" // Created By
    };

    try {
        const res = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.result === "success") {
            alert("Kharashka waa la keydiyey!");
            bootstrap.Modal.getInstance(document.getElementById('expenseModal')).hide();
            loadReceiptRefs(); // Dib u rari Dashboard-ka iyo xogta
        }
    } catch (err) {
        alert("Cillad ayaa dhacday xilliga keydinta kharashka.");
    } finally {
        btn.disabled = false;
        btn.innerHTML = "SAVE EXPENSE";
    }
});

function renderExpensesTable(expenses) {
    const tbody = document.getElementById('expenseTableBody');
    const expenseTab = document.getElementById('tab-expenses');
    const isMobile = window.innerWidth < 768;

    if (!expenseTab) return;

    const validExpenses = expenses.filter(e => e && (e.Description || e.description));

    if (isMobile) {
        // Create or get the mobile container
        let mobileExpContainer = document.getElementById('mobileExpenseCards');
        if (!mobileExpContainer) {
            mobileExpContainer = document.createElement('div');
            mobileExpContainer.id = 'mobileExpenseCards';
            mobileExpContainer.className = 'mobile-cards-container';
            expenseTab.appendChild(mobileExpContainer);
        }

        mobileExpContainer.innerHTML = validExpenses.length === 0 
            ? '<div class="text-center p-4 text-muted">No expenses found.</div>'
            : validExpenses.map(e => `
                <div class="survey-card border-start border-4 border-danger">
                    <div class="card-info">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="fw-bold">${e.Description || e.description}</div>
                            <div class="fw-bold text-danger">$${parseFloat(e.Total || e.total || 0).toFixed(2)}</div>
                        </div>
                        <div class="d-flex justify-content-between mt-2 small text-muted">
                            <span><i class="bi bi-calendar3"></i> ${formatDateMobile(e.Date || e.date)}</span>
                            <span>Qty: ${e.Qty || e.qty} | By: ${e['Created By'] || e.created_by || 'Admin'}</span>
                        </div>
                    </div>
                </div>
            `).join('');
    } else if (tbody) {
        // Desktop Table View
        tbody.innerHTML = validExpenses.map(e => `
            <tr>
                <td class="ps-4 fw-bold text-muted">${e['S/N'] || '-'}</td>
                <td class="fw-bold">${e.Description || e.description}</td>
                <td><small>${e.Date || e.date}</small></td>
                <td>${e.Qty || e.qty}</td>
                <td>$${parseFloat(e.Amount || e.amount || 0).toFixed(2)}</td>
                <td class="fw-bold text-danger">$${parseFloat(e.Total || e.total || 0).toFixed(2)}</td>
                <td><span class="badge bg-light text-dark border">${e['Created By'] || e.created_by || 'Admin'}</span></td>
            </tr>
        `).join('');
    }
}

function handleFabClick() {
    // Detect which view is currently active
    const activeView = document.querySelector('.app-view.active').id;

    switch (activeView) {
        case 'ref-view':
            showRefForm(); // Opens the Reference registration form
            break;
        case 'map-view':
        case 'list-view':
            switchTab('form-view'); // Opens the Land Survey form
            break;
        case 'receipt-view':
            // Check if we are on Payments or Expenses tab
            const activeFinanceTab = document.querySelector('#financeTabs .nav-link.active').getAttribute('data-bs-target');
            if (activeFinanceTab === '#tab-expenses') {
                showExpenseModal();
            } else {
                alert("Fadlan dooro Reference aad lacag ka qabanayso liiska hoose.");
            }
            break;
        case 'user-management':
            const userModal = new bootstrap.Modal(document.getElementById('addUserModal'));
            userModal.show();
            break;
        default:
            switchTab('form-view');
    }
}

function formatDateMobile(dateStr) {
    if (!dateStr || dateStr === 'N/A') return 'N/A';
    // Removes the 'T', the milliseconds, and the 'Z'
    return dateStr.split('T')[0] + ' ' + dateStr.split('T')[1].substring(0, 5);
}

let polygonLabels = []; // Global array to track tooltips

function displayAllPolygons() {
    if (!allRecords || allRecords.length === 0) return;

    // 1. Clean existing polygons and reset label tracker
    mainMap.eachLayer((layer) => {
        if (layer instanceof L.Polygon && !(layer instanceof L.Rectangle)) {
            mainMap.removeLayer(layer);
        }
    });
    polygonLabels = [];

    allRecords.forEach(record => {
        const polyString = record['Polygon Boundary'] || record['polygon'];
        
        if (polyString && polyString !== "N/A" && polyString.trim() !== "") {
            try {
                const polyCoords = polyString.split(/[;]+/)
                    .map(coord => coord.trim())
                    .filter(coord => coord.length > 0)
                    .map(c => c.split(',').map(Number));

                // 2. Create Yellow Polygon
                const polygon = L.polygon(polyCoords, {
                    color: '#FFD700',      // Gold/Yellow Outline
                    fillColor: '#FFFF00',  // Bright Yellow Fill
                    fillOpacity: 0.4,
                    weight: 3
                }).addTo(mainMap);

                // 3. Create Permanent Owner Label (Tooltip)
                const ownerName = record['Magaca Milkiilaha'] || 'Unknown';
                const label = L.tooltip({
                    permanent: true,
                    direction: 'center',
                    className: 'map-owner-label'
                })
                .setContent(ownerName)
                .setLatLng(polygon.getBounds().getCenter());
                
                polygon.bindTooltip(label);
                polygonLabels.push(label); 

                // 4. Bind Detail Popup
                polygon.bindPopup(`
                    <div class="p-1">
                        <h6 class="fw-bold mb-1">${ownerName}</h6>
                        <p class="small text-muted mb-2">S/N: ${record['S/N']}</p>
                        <button class="btn btn-sm btn-primary w-100" onclick='showRowDetails(${JSON.stringify(record)})'>
                            View Full Details
                        </button>
                    </div>
                `);
                
            } catch (err) {
                console.error("Error drawing polygon", err);
            }
        }
    });
    
    // Ensure initial toggle state is respected
    togglePolygonLabels();
}

// Function to Show/Hide Labels
function togglePolygonLabels() {
    const isChecked = document.getElementById('labelToggle').checked;
    const labels = document.querySelectorAll('.map-owner-label');
    labels.forEach(el => {
        el.style.display = isChecked ? 'block' : 'none';
    });
}

let allTransferRecords = [];

// Navigation Functions
function showTransferForm() {
    document.getElementById('transferListArea').style.display = 'none';
    document.getElementById('transferFormArea').style.display = 'block';
    document.getElementById('tr_date').value = new Date().toISOString().split('T')[0];
    populateTransferSurveyDropdown();
}

function hideTransferForm() {
    document.getElementById('transferListArea').style.display = 'block';
    document.getElementById('transferFormArea').style.display = 'none';
}

// Populate the Survey Link dropdown using existing allRecords
function populateTransferSurveyDropdown() {
    const dropdown = document.getElementById('tr_survey_link');
    dropdown.innerHTML = '<option value="">Dooro Sahanka...</option>';
    allRecords.forEach(r => {
        const option = document.createElement('option');
        option.value = `${r['S/N']} - ${r['Magaca Milkiilaha']}`;
        option.textContent = `${r['S/N']}. ${r['Magaca Milkiilaha']}`;
        dropdown.appendChild(option);
    });
}

// Submit Handler
document.getElementById('transferForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('trSaveBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Keydinaya...';

    const payload = {
        type: "landTransfer",
        iibiyaha: document.getElementById('tr_iibiyaha').value,
        tel_iibiyaha: document.getElementById('tr_tel_iibiyaha').value,
        iibsadaha: document.getElementById('tr_iibsadaha').value,
        tel_iibsadaha: document.getElementById('tr_tel_iibsadaha').value,
        survey_lr: document.getElementById('tr_survey_link').value,
        lacagta: document.getElementById('tr_lacagta').value,
        taariikh: document.getElementById('tr_date').value
    };

    try {
        const res = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.result === "success") {
            alert("Wareejinta si guul leh ayaa loo diiwaangeliyey!");
            document.getElementById('transferForm').reset();
            hideTransferForm();
            loadAllSystemData(); // Refresh all data
        }
    } catch (err) {
        alert("Cillad ayaa dhacday!");
    } finally {
        btn.disabled = false;
        btn.innerText = "SAVE TRANSFER RECORD";
    }
});

</script>
</body>
</html>