<button class="fab-btn d-md-none" id="smartFab" onclick="handleFabClick()">
    <i class="bi bi-plus-lg"></i>
</button>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.draw/1.0.4/leaflet.draw.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet-geometryutil@0.9.3/src/leaflet.geometryutil.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbz4w7kC_NnWBu1xxb3HoOqb42DXF6ncQsnpVdAGFH8-Q9UEhKbiEscGrkOksH-QGmjZlQ/exec";
    const satLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { maxZoom: 20, subdomains:['mt0','mt1','mt2','mt3'] });
    const mainMap = L.map('mainMap', { center: [3.1192, 43.6498], zoom: 14, layers: [satLayer] });
    
let miniMap, miniMarker, drawnItems;
let polygonData = ""; 
let sketchMap; 

function switchTab(viewId, el) {
    // 1. XIR MODAL-KA
    const modalElement = document.getElementById('detailsModal');
    if (modalElement) {
        const modalInstance = bootstrap.Modal.getInstance(modalElement);
        if (modalInstance) modalInstance.hide();
    }

    // 2. VIEW MANAGEMENT
    document.querySelectorAll('.app-view').forEach(v => v.classList.remove('active'));
    const activeView = document.getElementById(viewId);
    if (activeView) activeView.classList.add('active');

    // 3. NAVIGATION ACTIVE STATE
    document.querySelectorAll('.nav-sidebar .nav-link').forEach(n => n.classList.remove('active'));
    if (el) el.classList.add('active');

    // 4. MAAMULKA FAB (Dynamic Logic)
    const fab = document.querySelector('.fab-btn');
    if (fab) {
        // Step A: Determine Visibility
        // Hide FAB if we are already in the Survey Form
        fab.style.display = (viewId === 'form-view') ? 'none' : 'flex';

        // Step B: Assign Dynamic Actions
        fab.onclick = () => {
            switch (viewId) {
                case 'ref-view':
                    showRefForm(); // Opens Reference Form
                    break;
                case 'map-view':
                case 'list-view':
                    switchTab('form-view', document.querySelector('[onclick*="form-view"]')); // Opens Land Survey
                    break;
                case 'receipt-view':
                    // Check if we are on the Expenses sub-tab
                    const activeFinanceTab = document.querySelector('#financeTabs .nav-link.active')?.getAttribute('data-bs-target');
                    if (activeFinanceTab === '#tab-expenses') {
                        showExpenseModal();
                    } else {
                        alert("Fadlan dooro Reference aad lacag ka qabanayso liiska hoose.");
                    }
                    break;
                case 'user-management':
                    const userModal = new bootstrap.Modal(document.getElementById('addUserModal'));
                    userModal.show();
                    break;
                default:
                    console.log("No specific action for this tab.");
            }
        };
    }

    // 5. LAND SURVEY FORM (Maabka yar)
    if (viewId === 'form-view') {
        if (!miniMap) {
            setTimeout(() => {
                miniMap = L.map('miniMap', { 
                    center: [3.1192, 43.6498], 
                    zoom: 17,
                    tap: false,
                    clickTolerance: 30
                });
                L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { 
                    maxZoom: 22, subdomains:['mt0','mt1','mt2','mt3'] 
                }).addTo(miniMap);
                drawnItems = new L.FeatureGroup().addTo(miniMap);
                const drawControl = new L.Control.Draw({
                    draw: { 
                        polygon: { allowIntersection: false, shapeOptions: { color: '#3388ff', weight: 3 } }, 
                        rectangle: { shapeOptions: { color: '#3388ff', weight: 3 } },
                        marker: false, circle: false, polyline: false, circlemarker: false 
                    },
                    edit: { featureGroup: drawnItems }
                });
                miniMap.addControl(drawControl);

                miniMap.on(L.Draw.Event.CREATED, (e) => {
                    drawnItems.clearLayers();
                    const layer = e.layer;
                    drawnItems.addLayer(layer);
                    generateSketch(layer); 
                });
            }, 300);
        } else {
            setTimeout(() => { miniMap.invalidateSize(); }, 350);
        }
    }

    // 6. REFERENCES VIEW (Kaliya u diyaari foomka, xogtu mar hore ayey rarantahay)
    if (viewId === 'ref-view') { 
        hideRefForm();
        setupRefForm(); 
        populateSurveyDropdown(); 
    }

    // 7. MAPS & RECORDS (Cusboonaysiin cabirka kaliya)
    if (viewId === 'map-view' && mainMap) { 
        setTimeout(() => { 
            mainMap.invalidateSize(); 
            displayAllPolygons(); // <--- Add this call here
        }, 300); 
    }

    window.scrollTo({ top: 0, behavior: 'smooth' });
}

// FUNCTION-KA GUUD EE SKETCH-KA DHISA
function generateSketch(layer) {
    const latlngs = layer.getLatLngs()[0];
    polygonData = latlngs.map(c => `${c.lat.toFixed(6)},${c.lng.toFixed(6)}`).join('; ');

    // Soo saar kaadhka
    document.getElementById('sketchContainer').style.display = 'block';
    
    if (sketchMap) { sketchMap.remove(); }

    // Bilow maabka Sketch-ka
    sketchMap = L.map('sketchCanvas', {
        zoomControl: true,
        attributionControl: false,
        dragging: true,
        scrollWheelZoom: true,
        maxZoom: 22
    });

    // Sawir Polygon-ka (Black outline)
    L.polygon(latlngs, { 
        color: '#000', 
        weight: 3, 
        fillColor: '#f1f5f9', 
        fillOpacity: 0.1 
    }).addTo(sketchMap);

    const center = layer.getBounds().getCenter();
    const area = L.GeometryUtil.geodesicArea(latlngs).toFixed(2);

    // Area Label
    const areaMarker = L.marker(center, {
        icon: L.divIcon({
            className: 'sketch-area-label',
            html: `<div contenteditable="true" spellcheck="false" class="editable-field">Area: ${area} m²</div>`,
            iconSize: [140, 40],
            iconAnchor: [70, 20]
        })
    }).addTo(sketchMap);

    makeEditable(areaMarker);

    // Dimension Lines
    for (let i = 0; i < latlngs.length; i++) {
        const start = latlngs[i];
        const end = latlngs[(i + 1) % latlngs.length];
        addSketchDimension(start, end, sketchMap, center);
    }

    // Zoom-ka & Fitting
    sketchMap.invalidateSize();
    const paddedBounds = layer.getBounds().pad(0.25);
    sketchMap.fitBounds(paddedBounds, { padding: [20, 20], animate: false });

    setTimeout(() => {
        if (sketchMap.getZoom() > 21) { sketchMap.setZoom(21); }
    }, 250);
}

// Function-ka sawiraya xariiqda cabirka oo EDITABLE ah
function addSketchDimension(start, end, map, center) {
    const dist = map.distance(start, end).toFixed(1);
    const mid = L.latLng((start.lat + end.lat) / 2, (start.lng + end.lng) / 2);

    let angle = Math.atan2(end.lat - start.lat, end.lng - start.lng) * 180 / Math.PI;
    if (angle > 90 || angle < -90) { angle += 180; }

    const dx = mid.lng - center.lng;
    const dy = mid.lat - center.lat;
    const len = Math.sqrt(dx * dx + dy * dy);
    
    const offset = 0.000025; // Masaafada cabirka iyo xariiqda
    const ox = (dx / len) * offset;
    const oy = (dy / len) * offset;

    const p1 = L.latLng(start.lat + oy, start.lng + ox);
    const p2 = L.latLng(end.lat + oy, end.lng + ox);
    const labelPos = L.latLng((p1.lat + p2.lat) / 2, (p1.lng + p2.lng) / 2);

    L.polyline([p1, p2], { color: '#3388ff', weight: 1.5, opacity: 0.8 }).addTo(map);

    const distMarker = L.marker(labelPos, {
        icon: L.divIcon({
            className: 'sketch-dist-label',
            html: `
                <div contenteditable="true" spellcheck="false" class="editable-field" 
                     style="transform: rotate(${-angle}deg); min-width: 40px; transition: opacity 0.3s;">
                     ${dist}m
                </div>`,
            iconSize: [0, 0],
            iconAnchor: [0, 0] 
        })
    }).addTo(map);

    makeEditable(distMarker);
}
// SHAQADA SAXAYSA EDITABLE-KA
function makeEditable(marker) {
    marker.on('add', function() {
        const el = this.getElement().querySelector('.editable-field');
        if (el) {
            // Jooji in maabku xado Click-ka
            L.DomEvent.disableClickPropagation(el);
            L.DomEvent.on(el, 'mousedown touchstart dblclick', L.DomEvent.stopPropagation);
            
            // Cursor-ka u bedel qoraal
            el.style.cursor = 'text';
        }
    });
}

function updateMarkerLocation(lat, lng) {
    const coords = `${parseFloat(lat).toFixed(6)}, ${parseFloat(lng).toFixed(6)}`;
    document.getElementById('gpsInput').value = coords;
    if (miniMarker) {
        miniMarker.setLatLng([lat, lng]);
    } else {
        miniMarker = L.marker([lat, lng], { draggable: true }).addTo(miniMap);
        miniMarker.on('dragend', (event) => {
            const pos = event.target.getLatLng();
            updateMarkerLocation(pos.lat, pos.lng);
        });
    }
    miniMap.panTo([lat, lng]);
}

    function getLiveLocation() {
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition((pos) => {
                updateMarkerLocation(pos.coords.latitude, pos.coords.longitude);
            });
        }
    }

document.getElementById('surveyForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('saveBtn');
    btn.disabled = true; 
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Keydinaya...';

    // 1. Ururi xogta Sketch-ka
    let dimensions = [];
    document.querySelectorAll('#sketchCanvas .sketch-dist-label .editable-field').forEach(label => {
        dimensions.push(label.innerText.trim());
    });
    const sketchArea = document.querySelector('#sketchCanvas .sketch-area-label .editable-field');

    const payload = {
        magaca: document.getElementById('magaca').value,
        xaafadda: document.getElementById('xaafadda').value,
        laanta: document.getElementById('laanta').value,
        nooca: document.getElementById('nooca').value + (document.getElementById('maxaa_dhisan').value ? ": " + document.getElementById('maxaa_dhisan').value : ""),
        soohdimaha: `W:${document.getElementById('w_val').value}(${document.getElementById('w_deris').value}) | B:${document.getElementById('b_val').value}(${document.getElementById('b_deris').value}) | K:${document.getElementById('k_val').value}(${document.getElementById('k_deris').value}) | G:${document.getElementById('g_val').value}(${document.getElementById('g_deris').value})`,
        sketch_info: `Area: ${sketchArea ? sketchArea.innerText.trim() : "N/A"} | Dim: ${dimensions.join(' | ')}`,
        nawaaxiga: document.getElementById('nawaaxiga').value,
        location: document.getElementById('gpsInput').value, 
        polygon: polygonData 
    };

    try {
        const response = await fetch(SCRIPT_URL, {
            method: 'POST',
            body: JSON.stringify(payload),
            headers: {
                'Content-Type': 'text/plain;charset=utf-8'
            }
        });

        const result = await response.json();

        if (result.result === "success") {
            alert("Xogta si guul leh ayaa loo keydiyey!");
            
            // --- CUSBOONAYSIINTA XOGTA (BACKGROUND SYNC) ---
            allRecords = []; // Tirtir xogta hore ee local-ka ah
            await loadRecords(); // Si toos ah u soo dejiso xogta cusub background-ka
            // -----------------------------------------------

            document.getElementById('surveyForm').reset();
            document.getElementById('sketchContainer').style.display = 'none';
            polygonData = ""; 
            if (miniMarker) miniMap.removeLayer(miniMarker);
            if (drawnItems) drawnItems.clearLayers();
            
            switchTab('list-view'); // Ku noqo Records si aad u aragto xogta cusub
        } else {
            throw new Error(result.message || "Keydintu ma suurogalin");
        }

    } catch (err) { 
        console.error(err);
        alert("Cillad: Ma suuragalin in xogta la keydiyo. Hubi internet-kaaga ama Google Script."); 
    } finally { 
        btn.disabled = false; 
        btn.innerText = "SYNC TO CLOUD DATABASE"; 
    }
});

let modalMainMap, modalSketchMap;

async function showRowDetails(record) {
    const modalElement = document.getElementById('detailsModal');
    const myModal = bootstrap.Modal.getOrCreateInstance(modalElement);
    myModal.show();

    // 1. Buuxi xogta qoraalka (Labels)
    document.getElementById('view_sn').innerText = record['S/N'] || '-';
    document.getElementById('view_magaca').innerText = record['Magaca Milkiilaha'] || 'N/A';
    document.getElementById('view_taarikh').innerText = record['Taarikhda iyo Saacadda'] || 'N/A';
    document.getElementById('view_xaafada').innerText = record['Xaafadda'] || '-';
    document.getElementById('view_laanta').innerText = record['Laanta'] || '-';
    
    const nawaaxigaEl = document.getElementById('view_nawaaxiga');
    if(nawaaxigaEl) nawaaxigaEl.innerText = record['Nawaaxiga'] || '-';

    document.getElementById('view_nooca').innerText = record['Nooca Dhulka'] || 'N/A';
    document.getElementById('view_location').innerText = record['Location'] || 'N/A';

    // 2. KALA SAARISTA SOOHDIMAHA (TABLE)
    const rawSoohdin = record['Cabirka iyo Soohdimaha Dhulka'] || "";
    const tbody = document.getElementById('boundaryTableBody');
    
    if (tbody) {
        tbody.innerHTML = ""; 
        const directions = rawSoohdin.split(' | ');
        const labelMap = { 'W': 'Waqooyi', 'B': 'Bari', 'K': 'Koonfur', 'G': 'Galbeed' };

        directions.forEach(dir => {
            const parts = dir.split(':');
            if (parts.length === 2) {
                const jihadaCode = parts[0].trim();
                const jihadaName = labelMap[jihadaCode] || jihadaCode;
                const subParts = parts[1].split('(');
                const cabirka = subParts[0] ? subParts[0].trim() + "m" : "-";
                const deriska = subParts[1] ? subParts[1].replace(')', '').trim() : "-";

                tbody.innerHTML += `
                    <tr>
                        <td class="ps-3 py-2 fw-semibold text-primary" style="font-size: 13px;">${jihadaName}</td>
                        <td class="py-2 text-center fw-bold" style="font-size: 13px;">${cabirka}</td>
                        <td class="py-2 text-muted" style="font-size: 13px;">${deriska}</td>
                    </tr>`;
            }
        });
    }

    // 3. MAABYADA (MAPS) - XALKA CLEANUP IYO INVALIDATE
    setTimeout(() => {
        // Nadiifi maabyadii hore si looga fogaado "Map container already initialized"
        if (modalMainMap) { modalMainMap.remove(); modalMainMap = null; }
        if (modalSketchMap) { modalSketchMap.remove(); modalSketchMap = null; }

        // Hubi in xogta Polygon-ku ay jirto
        if (!record['Polygon Boundary'] || record['Polygon Boundary'] === "N/A") {
            console.warn("Polygon-ku ma hayo xog dhisan.");
            return;
        }

        try {
            const polyCoords = record['Polygon Boundary'].split('; ').map(c => c.split(',').map(Number));
            const polygon = L.polygon(polyCoords);
            const bounds = polygon.getBounds();

            // --- SATELLITE MAP ---
            modalMainMap = L.map('modalMainMap', { 
                attributionControl: false,
                scrollWheelZoom: false 
            }).fitBounds(bounds);

            L.tileLayer('https://{s}.google.com/vt/lyrs=y&x={x}&y={y}&z={z}', { 
                maxZoom: 20, 
                subdomains:['mt0','mt1','mt2','mt3'] 
            }).addTo(modalMainMap);

            L.polygon(polyCoords, { 
                color: 'cyan', 
                weight: 2, 
                fillOpacity: 0.2 
            }).addTo(modalMainMap);

            // --- TECHNICAL SKETCH MAP ---
            modalSketchMap = L.map('modalSketchCanvas', { 
                zoomControl: false, 
                attributionControl: false,
                dragging: true 
            });

            L.polygon(polyCoords, { 
                color: 'black', 
                weight: 3, 
                fillColor: '#ffffff', 
                fillOpacity: 1 
            }).addTo(modalSketchMap);

            const modalCenter = bounds.getCenter();
            
            // Ku dar xariiqyada cabirka (Dimensions)
            for (let i = 0; i < polyCoords.length; i++) {
                const start = L.latLng(polyCoords[i]);
                const end = L.latLng(polyCoords[(i + 1) % polyCoords.length]);
                // Hubi in function-kan 'addSketchDimension' uu koodhkaaga ku jiro
                if (typeof addSketchDimension === 'function') {
                    addSketchDimension(start, end, modalSketchMap, modalCenter);
                }
            }

            // Design-ka Area Label
            const sketchInfo = record['Sketch Details (Edited)'] || "";
            const areaValue = sketchInfo.split('|')[0].replace(/Area:|Area/gi, '').trim() || "N/A"; 

            L.marker(modalCenter, {
                icon: L.divIcon({ 
                    className: 'sketch-area-label-modal', 
                    html: `<div class="modal-area-box" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; text-align: center; background: white; border: 2px solid black; padding: 5px; border-radius: 6px; box-shadow: 2px 2px 0px rgba(0,0,0,0.1);">
                             <small style="display: block; font-size: 9px; color: #666; font-weight: 800; text-transform: uppercase; margin-bottom: -2px;">Area</small>
                             <strong>${areaValue}</strong>
                           </div>`, 
                    iconSize: [110, 50], 
                    iconAnchor: [55, 25]
                })
            }).addTo(modalSketchMap);

            // Cusboonaysii cabirka maabyada (Xalka muhiimka ah ee Modal-ka)
            modalMainMap.invalidateSize();
            modalSketchMap.invalidateSize();
            
            // FitBounds oo leh padding ku filan si uu Sketch-ku si fiican u muuqdo
            modalSketchMap.fitBounds(bounds, { 
                padding: [60, 60], 
                animate: true 
            });

        } catch (error) {
            console.error("Cillad ka timid sawirista maabka modal-ka:", error);
        }
    }, 600); // 600ms waa wakhtiga modal-ku ku furmo (transition)
}
// Cusboonaysii loadRecords() si uu u ogolaado Click-ka
let allRecords = []; // Halkan ku kaydi xogta si loo shaandheeyo

async function loadRecords() {
    const tbody = document.getElementById('recordsBody');
    const mobileContainer = document.getElementById('mobileCards');

    // 1. HUBI: Haddii allRecords ay xog hore u haysato, jooji Loading-ka cusub
    if (allRecords && allRecords.length > 0) {
        console.log("Xogta mar hore ayaa la soo dejiyey, dib looma load-gareynayo.");
        applyFilters(); // Kaliya u muuji xogta hore u jirtay
        return; 
    }

    // 2. Haddii ay madhan tahay, hadda soo dejiso
    if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center p-4">Loading...</td></tr>';
    
    try {
        const res = await fetch(SCRIPT_URL);
        allRecords = await res.json();
        applyFilters(); 
        displayAllPolygons();
    } catch (e) {
        console.error("Cillad xogta: ", e);
        if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center text-danger">Error loading data.</td></tr>';
    }
}

function applyFilters() {
    // 1. Qabashada xogta raadinta
    const searchGeneral = document.getElementById('filterSearch').value.toLowerCase();
    const sW = document.getElementById('searchW').value.trim();
    const sB = document.getElementById('searchB').value.trim();
    const sK = document.getElementById('searchK').value.trim();
    const sG = document.getElementById('searchG').value.trim();
    
    const xaafada = document.getElementById('filterXaafada').value;
    const laanta = document.getElementById('filterLaanta').value;
    const start = document.getElementById('filterStart').value;
    const end = document.getElementById('filterEnd').value;

    const filtered = allRecords.filter(r => {
        const boundaryText = (r['Cabirka iyo Soohdimaha Dhulka'] || "").toUpperCase();
        
        // A. Raadinta Guud (Magaca ama Xogta kale)
        const matchGeneral = r['Magaca Milkiilaha'].toLowerCase().includes(searchGeneral) || 
                             r['Xaafadda'].toLowerCase().includes(searchGeneral);

        // B. Raadinta Soohdimaha (Mid kasta goonideeda)
        // Waxay hubinaysaa tusaale: haddii W leedahay "25" (W:25)
        const matchW = sW === "" || boundaryText.includes(`W:${sW}`);
        const matchB = sB === "" || boundaryText.includes(`B:${sB}`);
        const matchK = sK === "" || boundaryText.includes(`K:${sK}`);
        const matchG = sG === "" || boundaryText.includes(`G:${sG}`);

        // C. Taariikhda
        const dateParts = r['Taarikhda iyo Saacadda'].split(' ')[0].split('/');
        const recordDate = new Date(`${dateParts[2]}-${dateParts[1]}-${dateParts[0]}`);
        const matchStart = start === "" || recordDate >= new Date(start);
        const matchEnd = end === "" || recordDate <= new Date(end);

        // D. Dropdowns
        const matchXaafada = xaafada === "" || r['Xaafadda'] === xaafada;
        const matchLaanta = laanta === "" || r['Laanta'] === laanta;

        // Isku dar dhammaan (AND Logic)
        return matchGeneral && matchW && matchB && matchK && matchG && 
               matchXaafada && matchLaanta && matchStart && matchEnd;
    });

    renderData(filtered);
}

function renderData(data) {
    const tbody = document.getElementById('recordsBody');
    const recordsContent = document.getElementById('recordsContent');
    const isMobile = window.innerWidth < 768;

    if (isMobile) {
        let cardsHtml = `
            <div class="mobile-cards-container">
                ${data.map(r => `
                    <div class="survey-card" onclick='showRowDetails(${JSON.stringify(r)})'>
                        <div class="card-sn">#${r['S/N']}</div>
                        <div class="card-info">
                            <div class="card-name">${r['Magaca Milkiilaha']}</div>
                            <div class="card-date"><i class="bi bi-clock me-1"></i> ${r['Taarikhda iyo Saacadda']}</div>
                            <div class="mt-1">
                                <span class="badge bg-light text-dark border-0" style="font-size:10px">${r['Xaafadda']}</span>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </div>
                `).join('')}
            </div>`;
        
        // Target the mobile container specifically
        document.getElementById('mobileCards').innerHTML = cardsHtml;
    } else {
        if (tbody) {
            tbody.innerHTML = data.map(r => `
                <tr onclick='showRowDetails(${JSON.stringify(r)})' style="cursor:pointer">
                    <td>${r['S/N']}</td>
                    <td class="fw-bold">${r['Magaca Milkiilaha']}</td>
                    <td><small>${r['Taarikhda iyo Saacadda']}</small></td>
                    <td><span class="badge bg-light text-dark border">${r['Xaafadda']}</span></td>
                    <td><small class="text-muted">${r['Cabirka iyo Soohdimaha Dhulka']}</small></td>
                    <td><code class="small text-primary">${r['Location']}</code></td>
                </tr>
            `).join('');
        }
    }
}

function syncFilters(sourceId, targetId) {
    const val = document.getElementById(sourceId).value;
    document.getElementById(targetId).value = val;
    applyFilters(); // Kici raadinta guud
}

function toggleDhisanField() {
    const noocaSelect = document.getElementById('nooca');
    const dhulDhisanDetails = document.getElementById('dhulDhisanDetails');
    const maxaaDhisanInput = document.getElementById('maxaa_dhisan');

    if (noocaSelect.value === "Dhul dhisan") {
        // Haddii uu doorto dhul dhisan, soo saar input-ka dheeriga ah
        dhulDhisanDetails.style.display = 'block';
        maxaaDhisanInput.setAttribute('required', 'true');
    } else {
        // Haddii kale, qari field-ka, nadiifina xogta ku jirtay
        dhulDhisanDetails.style.display = 'none';
        maxaaDhisanInput.removeAttribute('required');
        maxaaDhisanInput.value = "";
    }
}

function toggleMiniMapFullScreen() {
    const container = document.getElementById('miniMapContainer');
    const icon = document.querySelector('#miniMapContainer .bi');

    // Bedel class-ka
    container.classList.toggle('expanded-map');

    // Bedel Icon-ka (Expand/Compress)
    if (container.classList.contains('expanded-map')) {
        icon.classList.replace('bi-arrows-fullscreen', 'bi-fullscreen-exit');
    } else {
        icon.classList.replace('bi-fullscreen-exit', 'bi-arrows-fullscreen');
    }

    // Dib u sax cabirka maabka (Muhiim)
    setTimeout(() => {
        miniMap.invalidateSize();
        // Haddii uu jiro polygon hore loo sawiray, dhex-fariisi
        if (drawnItems.getLayers().length > 0) {
            miniMap.fitBounds(drawnItems.getBounds());
        }
    }, 300);
}

// 1. Marka tabka la riixo, geli taariikhda maanta automatic ahaan
function setupRefForm() {
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    document.getElementById('ref_date').value = now.toISOString().slice(0, 16);
}

// 2. Buuxi dropdown-ka Survey Lr adigoo isticmaalaya xogta allRecords
function populateSurveyDropdown() {
    const dropdown = document.getElementById('ref_survey_link');
    // Nadiifi xogta hore marka laga reebo option-ka kowaad
    dropdown.innerHTML = '<option value="">Dooro Sahanka (S/N & Magaca)...</option>';
    
    // allRecords waa array-ga ay ku jiraan xogta miiska (Records table)
    if (allRecords && allRecords.length > 0) {
        allRecords.forEach(record => {
            const sn = record['S/N'];
            const magaca = record['Magaca Milkiilaha'];
            
            const option = document.createElement('option');
            option.value = `${sn} - ${magaca}`;
            option.textContent = `${sn}. ${magaca}`; // Habka: "1. Mohamed Ibrahim"
            dropdown.appendChild(option);
        });
    }
}

